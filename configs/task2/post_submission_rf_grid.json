    "oob_score": true,
    "n_jobs": -1,
    "random_state_policy": "seed_plus_fold"
  },
  "candidates": [
    {"id": "r0_baseline", "min_samples_leaf": 2, "max_features": "sqrt"},
    {"id": "r1_leaf1", "min_samples_leaf": 1, "max_features": "sqrt"},
    {"id": "r2_leaf4", "min_samples_leaf": 4, "max_features": "sqrt"},
    {"id": "r3_features025", "min_samples_leaf": 2, "max_features": 0.25},
    {"id": "r4_leaf4_features025", "min_samples_leaf": 4, "max_features": 0.25}
  ],
  "selection": {
    "minimum_macro_f1_gain": 0.003,
    "minimum_spring_f1_delta": -0.005,
    "require_positive_paired_lower_95": true,
    "bootstrap_replicates": 10000
  }
}
