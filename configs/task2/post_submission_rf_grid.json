{
  "schema_version": "1.0.0",
  "study_id": "postsubmit-i2-rf-grid",
  "role": "post_submission_development_only",
  "base_i2_config": "configs/task2/g4_i2_article_type_lambda_0_3_c1.json",
  "baseline_summary": "results/evidence/task2/post_submission/boosting_summary.json",
  "seed": 2753,
  "folds": [0, 1, 2, 3, 4],
  "embedding_batch_size": 256,
  "fixed_parameters": {
    "n_estimators": 300,
    "criterion": "gini",
    "class_weight": "balanced_subsample",
