# Keep source and generated text byte-stable on Windows, macOS, and Linux.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.html text eol=lf
.gitignore text eol=lf

# Generated archives and report assets are binary.
*.csv.gz binary
*.png binary
*.pdf binary
*.zip binary

# Historical Task 3 receipts are hashed as bytes, including their original newlines.
reports/task3/**/*.csv -text
reports/task3/**/*.json -text
reports/task3/**/licenses/* -text

# Task 1 frozen inputs must retain the exact bytes recorded by the saved evaluation.
configs/task1/final_evaluation.json -text
src/fashion/task1/refit.py -text
